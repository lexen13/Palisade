# ============================================================
# CUI PROTECTION — do not remove or loosen these rules
# ============================================================
# Session files contain hostnames, IP addresses, MAC addresses, full software
# inventories, and open-port data for a real enclave. They are CUI. Never commit one.
*Session*.json
session*.json

# Scan data
*.nessus
*.nessus.xml
scans/
nessus/

# SCAP results and checklists — per-rule results for real hosts
*.ckl
*.cklb
*XCCDF*.xml
*xccdf*.xml
Results_*.zip
checklists/
scc-results/

# Generated artifacts — all contain real host and software data
STIG_Applicability*.csv
Software_Listing*.csv
PPSM_Registry*.txt
PPSM_WorkingCopy*.csv
Asset_Inventory*.csv
Asset_Reconciliation*.csv
Change_Record*.csv
Unsupported_Components*.csv
