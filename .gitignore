OS_Package_Manifest*.csv
eMASS_*.csv
Control_Mapping*.csv
Account_Audit*.csv
POAM_Draft*.csv
Prioritized_Vulnerabilities*.csv
Vulnerability_Detail*.csv
Vulnerability_Report*.html
IP_Summary*.csv
Scan_Coverage*.csv
STIG_Compliance_Summary*.csv
STIG_Open_Findings*.csv
STIG_Coverage*.csv
Trend_Burndown*.csv
Remediation_Plan*.csv
Asset_Report*.csv
exports/
output/

# Site-specific configuration — keep local, never publish
config.local.json
*.local.json
site-config/

# Credentials
*.key
*.pem
*.pfx
apikeys*
secrets*
.env

# Synthetic test data is allowed -- fictional hosts only, RFC 5737 / RFC 5398 addresses.
# NEVER place a real scan export here.
!test-data/
!test-data/*.nessus

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
